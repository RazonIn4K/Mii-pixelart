{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomodachi-studio",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  // Preserve the current Pages runtime behavior for the first parity cutover.
  // Advance this in a dedicated, tested compatibility update.
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/sitemap-images.xml",
      "/",
      "/studio",
      "/guides",
      "/faq",
      "/about",
      "/help",
      "/ai-plan",
      "/unlock",
      "/support",
      "/donate",
      "/privacy",
      "/terms",
      "/cookies",
      "/affiliate-disclosure",
      "/disclosure",
      "/community-guidelines",
      "/copyright",
      "/security",
      "/u/*",
      "/creation/*",
      "/discover",
      "/search",
      "/moderation",
      "/me",
      "/me/*",
    ],
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_SITE_URL": "http://localhost:3000",
    "GOOGLE_OIDC_REDIRECT_URI": "http://localhost:3000/api/auth/google/callback",
    "TERMS_VERSION": "2026-07-16",
    "COMMUNITY_MUTATIONS_ENABLED": "true",
    "AI_IMAGE_GENERATION_ENABLED": "true",
    "AI_IMAGE_DAILY_BUDGET_MICRO_USD": "2000000",
    "AI_IMAGE_USER_DAILY_LIMIT": "3",
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "OIDC_COOKIE_KEY",
      "SESSION_PEPPER",
      "PSEUDONYM_KEY",
      "OPENROUTER_API_KEY",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tomodachi-studio-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PROJECTS",
      "bucket_name": "tomodachi-studio-projects-local",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "EDGE_CACHE",
      "id": "5129b5ce8d2d435cb704b398a437f355",
    },
  ],
  "images": {
    "binding": "IMAGES",
    "remote": false,
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "SAVE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "SOCIAL_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "DISCOVERY_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "COMMENT_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "env": {
    "staging": {
      "name": "tomodachi-studio-staging",
      "workers_dev": false,
      "preview_urls": false,
      "limits": {
        "cpu_ms": 2000,
      },
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [{ "pattern": "staging.tomodachi.pw", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_SITE_URL": "https://staging.tomodachi.pw",
        "GOOGLE_OIDC_REDIRECT_URI": "https://staging.tomodachi.pw/api/auth/google/callback",
        "TERMS_VERSION": "2026-07-16",
        "COMMUNITY_MUTATIONS_ENABLED": "true",
        "AI_IMAGE_GENERATION_ENABLED": "true",
        "AI_IMAGE_DAILY_BUDGET_MICRO_USD": "2000000",
        "AI_IMAGE_USER_DAILY_LIMIT": "3",
      },
      "secrets": {
        "required": [
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "OIDC_COOKIE_KEY",
          "SESSION_PEPPER",
          "PSEUDONYM_KEY",
          "OPENROUTER_API_KEY",
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tomodachi-studio-staging",
          "database_id": "57c021c9-fa3b-4f93-b8fc-025822e757c2",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PROJECTS",
          "bucket_name": "tomodachi-studio-projects-staging",
        },
      ],
      "kv_namespaces": [
        { "binding": "EDGE_CACHE", "id": "c79d996b11084e84b5953834104b8152" },
      ],
      "images": { "binding": "IMAGES", "remote": false },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1101",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "SAVE_RATE_LIMITER",
          "namespace_id": "1102",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "SOCIAL_RATE_LIMITER",
          "namespace_id": "1103",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "DISCOVERY_RATE_LIMITER",
          "namespace_id": "1104",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "COMMENT_RATE_LIMITER",
          "namespace_id": "1105",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "1106",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "tomodachi-studio-production",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
      },
      "routes": [
        { "pattern": "tomodachi.pw", "custom_domain": true },
        { "pattern": "www.tomodachi.pw", "custom_domain": true },
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_SITE_URL": "https://tomodachi.pw",
        "GOOGLE_OIDC_REDIRECT_URI": "https://tomodachi.pw/api/auth/google/callback",
        "TERMS_VERSION": "2026-07-16",
        "COMMUNITY_MUTATIONS_ENABLED": "true",
        "AI_IMAGE_GENERATION_ENABLED": "true",
        "AI_IMAGE_DAILY_BUDGET_MICRO_USD": "2000000",
        "AI_IMAGE_USER_DAILY_LIMIT": "3",
      },
      "secrets": {
        "required": [
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "OIDC_COOKIE_KEY",
          "SESSION_PEPPER",
          "PSEUDONYM_KEY",
          "OPENROUTER_API_KEY",
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tomodachi-studio-production",
          "database_id": "546e38cb-db52-4823-8e49-1f2ce2c17120",
          "migrations_dir": "./migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PROJECTS",
          "bucket_name": "tomodachi-studio-projects-production",
        },
      ],
      "kv_namespaces": [
        { "binding": "EDGE_CACHE", "id": "699b9f148d4a450fae9f423cc3ef4c2c" },
      ],
      "images": { "binding": "IMAGES", "remote": false },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1201",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "SAVE_RATE_LIMITER",
          "namespace_id": "1202",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "SOCIAL_RATE_LIMITER",
          "namespace_id": "1203",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "DISCOVERY_RATE_LIMITER",
          "namespace_id": "1204",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "COMMENT_RATE_LIMITER",
          "namespace_id": "1205",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "1206",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
