{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomodachi-studio",
  "main": "./worker/index.ts",
  // Preserve the current Pages runtime behavior for the first parity cutover.
  // Advance this in a dedicated, tested compatibility update.
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/studio",
      "/guides",
      "/faq",
      "/about",
      "/help",
      "/unlock",
      "/support",
      "/donate",
      "/privacy",
      "/terms",
      "/cookies",
      "/affiliate-disclosure",
      "/disclosure",
      "/community-guidelines",
      "/copyright",
      "/security",
      "/u/*",
      "/creation/*",
      "/discover",
      "/search",
      "/moderation",
      "/me",
      "/me/*"
    ]
  },
  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_SITE_URL": "http://localhost:3000",
    "GOOGLE_OIDC_REDIRECT_URI": "http://localhost:3000/api/auth/google/callback",
    "TERMS_VERSION": "2026-07-10"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tomodachi-studio-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROJECTS",
      "bucket_name": "tomodachi-studio-projects-local"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EDGE_CACHE",
      "id": "5129b5ce8d2d435cb704b398a437f355"
    }
  ],
  "images": {
    "binding": "IMAGES",
    "remote": false
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SAVE_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "SOCIAL_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "DISCOVERY_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "COMMENT_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "env": {
    "staging": {
      "name": "tomodachi-studio-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_SITE_URL": "https://staging.tomodachi.pw",
        "GOOGLE_OIDC_REDIRECT_URI": "https://staging.tomodachi.pw/api/auth/google/callback",
        "TERMS_VERSION": "2026-07-10"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "tomodachi-studio-staging", "database_id": "11111111-1111-1111-1111-111111111111", "migrations_dir": "./migrations" }
      ],
      "r2_buckets": [
        { "binding": "PROJECTS", "bucket_name": "tomodachi-studio-projects-staging" }
      ],
      "kv_namespaces": [
        { "binding": "EDGE_CACHE", "id": "11111111111111111111111111111111" }
      ],
      "images": { "binding": "IMAGES", "remote": false },
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
        { "name": "SAVE_RATE_LIMITER", "namespace_id": "1102", "simple": { "limit": 30, "period": 60 } },
        { "name": "SOCIAL_RATE_LIMITER", "namespace_id": "1103", "simple": { "limit": 60, "period": 60 } },
        { "name": "DISCOVERY_RATE_LIMITER", "namespace_id": "1104", "simple": { "limit": 120, "period": 60 } },
        { "name": "COMMENT_RATE_LIMITER", "namespace_id": "1105", "simple": { "limit": 10, "period": 60 } }
      ]
    },
    "production": {
      "name": "tomodachi-studio-production",
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_SITE_URL": "https://tomodachi.pw",
        "GOOGLE_OIDC_REDIRECT_URI": "https://tomodachi.pw/api/auth/google/callback",
        "TERMS_VERSION": "2026-07-10"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "tomodachi-studio-production", "database_id": "22222222-2222-2222-2222-222222222222", "migrations_dir": "./migrations" }
      ],
      "r2_buckets": [
        { "binding": "PROJECTS", "bucket_name": "tomodachi-studio-projects-production" }
      ],
      "kv_namespaces": [
        { "binding": "EDGE_CACHE", "id": "22222222222222222222222222222222" }
      ],
      "images": { "binding": "IMAGES", "remote": false },
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1201", "simple": { "limit": 10, "period": 60 } },
        { "name": "SAVE_RATE_LIMITER", "namespace_id": "1202", "simple": { "limit": 30, "period": 60 } },
        { "name": "SOCIAL_RATE_LIMITER", "namespace_id": "1203", "simple": { "limit": 60, "period": 60 } },
        { "name": "DISCOVERY_RATE_LIMITER", "namespace_id": "1204", "simple": { "limit": 120, "period": 60 } },
        { "name": "COMMENT_RATE_LIMITER", "namespace_id": "1205", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}
