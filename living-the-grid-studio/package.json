{
  "name": "living-the-grid-studio",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "start": "vite preview --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "worker:types": "wrangler types worker/env.d.ts --env-file .dev.vars.example",
    "db:migrate:local": "wrangler d1 migrations apply tomodachi-studio-local --local",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:preflight": "vitest run --config vitest.preflight.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:staging": "PLAYWRIGHT_BASE_URL=https://staging.tomodachi.pw PLAYWRIGHT_ANALYTICS_MODE=no-provider playwright test",
    "worker:dry-run": "tsx scripts/worker-release.ts --target local --intent dry-run",
    "worker:dry-run:staging": "tsx scripts/worker-release.ts --target staging --intent dry-run",
    "worker:dry-run:production": "tsx scripts/worker-release.ts --target production --intent dry-run",
    "worker:deploy:staging": "tsx scripts/worker-release.ts --target staging --intent deploy",
    "worker:deploy:production": "tsx scripts/worker-release.ts --target production --intent deploy",
    "verify": "pnpm check && pnpm verify:licenses && pnpm verify:openapi && pnpm verify:migrations && pnpm verify:ltg && pnpm verify:image-import && pnpm verify:templates && pnpm verify:ai-sketch && pnpm verify:residents",
    "verify:licenses": "tsx scripts/verify-licenses.ts",
    "verify:openapi": "tsx scripts/verify-openapi-routes.ts",
    "verify:migrations": "tsx scripts/verify-migrations.ts",
    "verify:ltg": "tsx scripts/verify-ltg-import.ts",
    "verify:image-import": "tsx scripts/verify-image-import.ts",
    "verify:templates": "tsx scripts/verify-creative-templates.ts",
    "verify:ai-sketch": "tsx scripts/verify-ai-sketch.ts",
    "verify:residents": "tsx scripts/verify-residents.ts",
    "verify:bundle": "tsx scripts/verify-bundle-budgets.ts",
    "verify:hosted-read-only": "tsx scripts/verify-hosted-read-only.ts",
    "verify:hosted-staging-writable": "tsx scripts/verify-hosted-staging-writable-cli.ts",
    "verify:hosted-staging-p4-phase-a": "tsx scripts/verify-hosted-staging-p4-phase-a-cli.ts",
    "verify:staging-live-auth": "tsx scripts/verify-staging-live-auth.ts",
    "verify:release-output": "tsx scripts/verify-release-output.ts",
    "verify:studio": "tsx scripts/verify-studio-browser.ts",
    "cloudflare:security-insights": "tsx scripts/cloudflare-security-insights.ts",
    "save:templates": "tsx scripts/save-creative-template-fixtures.ts",
    "benchmark:ai-images": "tsx scripts/benchmark-openrouter-images.ts",
    "compare:models": "tsx scripts/compare-openrouter-models.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "hono": "4.12.29",
    "idb": "8.0.3",
    "jose": "6.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.5",
    "next-themes": "^0.4.6",
    "openid-client": "6.8.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260723.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.10",
    "postcss": "8.5.18",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.12.0"
}
